# Copy this file to .env and fill in real values. Never commit .env.

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# SQLite database location (relative to project root)
DATA_DIR=./data

# --- Token encryption ---------------------------------------------------------
# 64 hex chars (32 bytes). If empty, a key is generated in DATA_DIR/secret.key.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (YouTube Data API v3) -------------------------------------
# Create an OAuth client of type "Web application" with redirect URI:
#   http://127.0.0.1:3000/oauth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- AI provider (OpenAI-compatible chat completions) -------------------------
# Leave AI_API_KEY empty to use only the local preset library.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=30000

# --- Chat provider ------------------------------------------------------------
# "youtube" for real posting, "test" for a dry-run provider that never posts.
CHAT_PROVIDER=test
